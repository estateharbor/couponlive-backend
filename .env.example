# =========================================================================
# CouponLive — environment configuration
# Copy to `.env` and fill in. Never commit the real `.env`.
# =========================================================================

# --- Runtime environment -------------------------------------------------
# One of: dev | prod
# Controls scrape frequency, logging verbosity, and safety throttles.
COUPONLIVE_ENV=dev

# --- Database ------------------------------------------------------------
# Local Postgres example:
#   postgresql+psycopg://postgres:postgres@localhost:5432/couponlive
# Supabase / Neon: use the connection string they give you, but swap the
# driver prefix to `postgresql+psycopg://`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/couponlive

# --- Redis (Celery broker + result backend) ------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Scraping cadence ----------------------------------------------------
# In dev we deliberately run slow and limited to avoid hammering sources
# while developing. Prod uses each source's own scrape_frequency_minutes.
# Global multiplier applied on top of per-source frequency (dev = slower).
SCRAPE_FREQUENCY_MULTIPLIER=4.0        # dev: 4x slower than configured. prod: set to 1.0
SCRAPE_MAX_SOURCES_PER_RUN=1           # dev: only 1 source per cycle. prod: 0 = no limit
SCRAPE_MIN_DELAY_SECONDS=2             # randomized per-request delay lower bound
SCRAPE_MAX_DELAY_SECONDS=8             # randomized per-request delay upper bound

# --- Validation cadence (Phase 4) ----------------------------------------
VALIDATE_TOP_MERCHANT_REVALIDATE_HOURS=4
VALIDATION_ENABLED=false               # keep OFF until Phase 4 is reviewed & authorized

# --- Confidence / staleness policy ---------------------------------------
# Coupons older than this (since last successful validation) drop out of
# the default `status=valid` API results.
SERVE_FRESHNESS_HOURS=4
STALE_EXPIRE_HOURS=48                  # background job flags these as expired

# --- Proxy rotation (Phase 4 hook — interface only, no provider yet) ------
# Leave blank. Wiring a real provider is a decision to make explicitly.
PROXY_PROVIDER=                        # e.g. "none" | "brightdata" | "custom"
PROXY_POOL_URL=

# --- Affiliate network APIs (recommended primary ingestion path) ----------
# Fill these in as you obtain access. When present, the ingestion layer
# should prefer these over scraping the corresponding public site.
CUELINKS_API_KEY=
INRDEALS_API_KEY=                       # INRDeals API token (coupon-feed endpoint)
INRDEALS_USERNAME=                      # INRDeals username, sent as the `id` param
EARNKARO_API_KEY=
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
VCOMMISSION_API_KEY=

# --- LinkMyDeals coupon-feed API ------------------------------------------
# Get both from your LinkMyDeals dashboard (API section / advanced pack).
LINKMYDEALS_API_URL=https://feed.linkmydeals.com/getOffers/
LINKMYDEALS_API_KEY=                    # your LinkMyDeals API key
LINKMYDEALS_SYNC_FREQUENCY_MINUTES=30   # how often to pull the incremental feed

# --- Alerting (Phase 6 — log-based for now) -------------------------------
ALERT_WEBHOOK_URL=                     # optional Slack/webhook; empty = log only
ALERT_MIN_SUCCESS_RATE=0.5             # fire alert when a scrape run drops below this
SOURCE_STALE_HOURS=24                  # fire alert when a source hasn't succeeded in this long

# --- Feedback abuse prevention -------------------------------------------
FEEDBACK_IP_SALT=change-me-in-prod     # salt for hashing submitter IPs (raw IP never stored)

# --- API server ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API from a browser (the frontend).
CORS_ORIGINS=https://couponlive.in,https://www.couponlive.in,http://localhost:3000
