# Copy to `.env` on the VPS (next to docker-compose.yml) and edit.
# docker compose reads this for both interpolation and the containers' env.

# --- Postgres (used to build DATABASE_URL in docker-compose.yml) ----------
POSTGRES_USER=couponlive
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_password
POSTGRES_DB=couponlive

# --- App runtime ----------------------------------------------------------
COUPONLIVE_ENV=prod
SCRAPE_FREQUENCY_MULTIPLIER=1.0
VALIDATION_ENABLED=false               # keep off until Playwright worker is set up
FEEDBACK_IP_SALT=CHANGE_ME_random_salt
CORS_ORIGINS=https://couponlive.in,https://www.couponlive.in

# Affiliate API (optional — fill when you have them)
# INRDEALS_API_KEY=
# INRDEALS_USERNAME=

# --- Domains (Caddy auto-HTTPS) -------------------------------------------
SITE_DOMAIN=couponlive.in
API_DOMAIN=api.couponlive.in

# --- Where the built frontend (Next.js out/) lives on the host ------------
WEB_ROOT=./web
